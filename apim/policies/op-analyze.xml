<policies>
  <inbound>
    <base />
    <set-variable name="cell"      value="@((string)JObject.Parse((string)context.Variables[&quot;tenantCfg&quot;])[&quot;cell&quot;])" />
    <set-variable name="tier"      value="@((string)JObject.Parse((string)context.Variables[&quot;tenantCfg&quot;])[&quot;tier&quot;])" />
    <set-variable name="overflow"  value="@((bool)JObject.Parse((string)context.Variables[&quot;tenantCfg&quot;])[&quot;overflow&quot;])" />
    <set-variable name="modelId"   value="@(context.Request.MatchedParameters[&quot;modelId&quot;])" />

    <!-- Model allowlist: prebuilt models, or custom models carrying this tenant's prefix. -->
    <choose>
      <when condition="@{
          var m = (string)context.Variables[&quot;modelId&quot;];
          var p = (string)JObject.Parse((string)context.Variables[&quot;tenantCfg&quot;])[&quot;modelPrefix&quot;];
          return !(m.StartsWith(&quot;prebuilt-&quot;) || (!string.IsNullOrEmpty(p) &amp;&amp; m.StartsWith(p)));
      }">
        <return-response><set-status code="403" reason="Model not permitted for tenant" /></return-response>
      </when>
    </choose>

    <!-- Inline uploads capped at 50 MB; larger documents must use urlSource from staged Blob. -->
    <choose>
      <when condition="@(long.Parse(context.Request.Headers.GetValueOrDefault(&quot;Content-Length&quot;, &quot;0&quot;)) &gt; 52428800)">
        <return-response><set-status code="413" reason="Use urlSource for documents over 50 MB" /></return-response>
      </when>
    </choose>

    <!-- Per-tenant admission: 5 s sliding window allows short bursts while holding the average. -->
    <choose>
      <when condition="@((string)context.Variables[&quot;tier&quot;] == &quot;gold&quot;)">
        <rate-limit-by-key calls="30" renewal-period="5"
                           counter-key="@(&quot;an:&quot; + (string)context.Variables[&quot;tenant&quot;])"
                           retry-after-header-name="Retry-After" />
      </when>
      <otherwise>
        <rate-limit-by-key calls="10" renewal-period="5"
                           counter-key="@(&quot;an:&quot; + (string)context.Variables[&quot;tenant&quot;])"
                           retry-after-header-name="Retry-After" />
      </otherwise>
    </choose>
    <quota-by-key calls="200000" renewal-period="86400"
                  counter-key="@(&quot;q:&quot; + (string)context.Variables[&quot;tenant&quot;])" />

    <rewrite-uri template="@(&quot;/documentModels/&quot; + (string)context.Variables[&quot;modelId&quot;] + &quot;:analyze&quot;)" copy-unmatched-params="true" />

    <!-- Capacity-based routing. Analyze calls are counted per pool per second in the
         external Redis cache attached to APIM (shared by every gateway unit; see
         modules/platform/redis.tf). Below {{overflow-threshold-pct}}% of the
         home pool's capacity, the home pool serves the request. At or above it, requests from
         overflow-enabled tenants are sent to the tenant's zone overflow pool instead of being
         rejected, while the overflow pool is itself below the threshold and the tenant is within
         its share of it. If the overflow pool is also busy, the request still goes to the home
         pool: the gateway never rejects on pool capacity. Counters are approximate (non-atomic). -->
    <set-variable name="zone" value="@((string)JObject.Parse((string)context.Variables[&quot;tenantCfg&quot;])[&quot;zone&quot;])" />
    <set-variable name="second" value="@((DateTime.UtcNow.Ticks / TimeSpan.TicksPerSecond).ToString())" />
    <!-- Named value holds base64(JSON) pool => { tps }; see named_values.tf. -->
    <set-variable name="capMap" value="@(Encoding.UTF8.GetString(Convert.FromBase64String(&quot;{{pool-capacity-map}}&quot;)))" />
    <set-variable name="homeLimit" value="@{
        var c = JObject.Parse((string)context.Variables[&quot;capMap&quot;])[(string)context.Variables[&quot;cell&quot;]];
        return c == null ? int.MaxValue : (int)Math.Floor((double)c[&quot;tps&quot;] * {{overflow-threshold-pct}} / 100.0);
    }" />
    <set-variable name="ovfLimit" value="@{
        var c = JObject.Parse((string)context.Variables[&quot;capMap&quot;])[&quot;overflow-&quot; + (string)context.Variables[&quot;zone&quot;]];
        return c == null ? 0 : (int)Math.Floor((double)c[&quot;tps&quot;] * {{overflow-threshold-pct}} / 100.0);
    }" />
    <set-variable name="tenantOvfLimit" value="@{
        var c = JObject.Parse((string)context.Variables[&quot;capMap&quot;])[&quot;overflow-&quot; + (string)context.Variables[&quot;zone&quot;]];
        return c == null ? 0 : Math.Max(1, (int)Math.Floor((double)c[&quot;tps&quot;] * {{overflow-tenant-share-pct}} / 100.0));
    }" />
    <set-variable name="homePool" value="@(&quot;pool-&quot; + (string)context.Variables[&quot;cell&quot;])" />
    <set-variable name="ovfPool" value="@(&quot;pool-overflow-&quot; + (string)context.Variables[&quot;zone&quot;])" />
    <set-variable name="homeKey" value="@(&quot;cap:&quot; + (string)context.Variables[&quot;cell&quot;] + &quot;:&quot; + (string)context.Variables[&quot;second&quot;])" />
    <set-variable name="ovfKey" value="@(&quot;cap:overflow-&quot; + (string)context.Variables[&quot;zone&quot;] + &quot;:&quot; + (string)context.Variables[&quot;second&quot;])" />
    <set-variable name="tenantOvfKey" value="@(&quot;ovf:&quot; + (string)context.Variables[&quot;tenant&quot;] + &quot;:&quot; + (string)context.Variables[&quot;second&quot;])" />

    <cache-lookup-value key="@((string)context.Variables[&quot;homeKey&quot;])" variable-name="homeCount" default-value="0" caching-type="external" />
    <set-variable name="spill" value="@((bool)context.Variables[&quot;overflow&quot;] &amp;&amp; (int)context.Variables[&quot;ovfLimit&quot;] &gt; 0 &amp;&amp; Convert.ToInt32(context.Variables[&quot;homeCount&quot;]) &gt;= (int)context.Variables[&quot;homeLimit&quot;])" />
    <choose>
      <when condition="@((bool)context.Variables[&quot;spill&quot;])">
        <cache-lookup-value key="@((string)context.Variables[&quot;ovfKey&quot;])" variable-name="ovfCount" default-value="0" caching-type="external" />
        <cache-lookup-value key="@((string)context.Variables[&quot;tenantOvfKey&quot;])" variable-name="tenantOvfCount" default-value="0" caching-type="external" />
        <set-variable name="spill" value="@(Convert.ToInt32(context.Variables[&quot;ovfCount&quot;]) &lt; (int)context.Variables[&quot;ovfLimit&quot;] &amp;&amp; Convert.ToInt32(context.Variables[&quot;tenantOvfCount&quot;]) &lt; (int)context.Variables[&quot;tenantOvfLimit&quot;])" />
      </when>
    </choose>
    <choose>
      <when condition="@((bool)context.Variables[&quot;spill&quot;])">
        <cache-store-value key="@((string)context.Variables[&quot;ovfKey&quot;])" value="@((Convert.ToInt32(context.Variables[&quot;ovfCount&quot;]) + 1).ToString())" duration="2" caching-type="external" />
        <cache-store-value key="@((string)context.Variables[&quot;tenantOvfKey&quot;])" value="@((Convert.ToInt32(context.Variables[&quot;tenantOvfCount&quot;]) + 1).ToString())" duration="2" caching-type="external" />
        <set-variable name="route" value="@((string)context.Variables[&quot;ovfPool&quot;])" />
        <set-variable name="altRoute" value="@((string)context.Variables[&quot;homePool&quot;])" />
      </when>
      <otherwise>
        <cache-store-value key="@((string)context.Variables[&quot;homeKey&quot;])" value="@((Convert.ToInt32(context.Variables[&quot;homeCount&quot;]) + 1).ToString())" duration="2" caching-type="external" />
        <set-variable name="route" value="@((string)context.Variables[&quot;homePool&quot;])" />
        <set-variable name="altRoute" value="@((bool)context.Variables[&quot;overflow&quot;] &amp;&amp; (int)context.Variables[&quot;ovfLimit&quot;] &gt; 0 ? (string)context.Variables[&quot;ovfPool&quot;] : (string)context.Variables[&quot;homePool&quot;])" />
      </otherwise>
    </choose>
    <set-backend-service backend-id="@((string)context.Variables[&quot;route&quot;])" />
  </inbound>

  <backend>
    <!-- Attempt 1: the chosen pool. Attempt 2: the same pool again (skips the tripped member).
         Attempt 3: the other pool (home <-> zone overflow) for overflow-enabled tenants,
         otherwise the home pool once more. -->
    <retry condition="@(context.Response == null || context.Response.StatusCode == 429 || context.Response.StatusCode == 503)"
           count="2" interval="0" first-fast-retry="true">
      <set-variable name="servedPool" value="@(context.Variables.ContainsKey(&quot;attempt&quot;) &amp;&amp; (int)context.Variables[&quot;attempt&quot;] &gt;= 1 ? (string)context.Variables[&quot;altRoute&quot;] : (string)context.Variables[&quot;route&quot;])" />
      <set-backend-service backend-id="@((string)context.Variables[&quot;servedPool&quot;])" />
      <set-variable name="attempt" value="@(context.Variables.ContainsKey(&quot;attempt&quot;) ? (int)context.Variables[&quot;attempt&quot;] + 1 : 0)" />
      <forward-request buffer-request-body="true" timeout="60" />
    </retry>
  </backend>

  <outbound>
    <base />
    <!-- Which pool served the request (home or overflow), for logs and load tests. -->
    <set-header name="x-daas-pool" exists-action="override">
      <value>@((string)context.Variables.GetValueOrDefault(&quot;servedPool&quot;, &quot;&quot;))</value>
    </set-header>
    <!-- Replace DI's Operation-Location with a signed, tenant-bound gateway URL. -->
    <choose>
      <when condition="@(context.Response.StatusCode == 202)">
        <!-- Named value holds base64(JSON); see api-di-v1.xml. -->
        <set-variable name="hostMap" value="@(Encoding.UTF8.GetString(Convert.FromBase64String(&quot;{{di-host-map}}&quot;)))" />
        <set-header name="Operation-Location" exists-action="override">
          <value>@{
            var op   = new Uri(context.Response.Headers.GetValueOrDefault(&quot;Operation-Location&quot;, &quot;&quot;));
            var key  = (string)JObject.Parse((string)context.Variables[&quot;hostMap&quot;])[op.Host];
            var m    = Regex.Match(op.AbsolutePath, &quot;documentModels/([^/]+)/analyzeResults/([^/?]+)&quot;);
            var raw  = string.Join(&quot;|&quot;, key, m.Groups[1].Value, m.Groups[2].Value, (string)context.Variables[&quot;tenant&quot;]);
            var body = Convert.ToBase64String(Encoding.UTF8.GetBytes(raw)).TrimEnd('=').Replace('+','-').Replace('/','_');
            using (var h = new HMACSHA256(Convert.FromBase64String(&quot;{{result-signing-key}}&quot;))) {
              var sig = Convert.ToBase64String(h.ComputeHash(Encoding.UTF8.GetBytes(body))).TrimEnd('=').Replace('+','-').Replace('/','_');
              return &quot;https://{{gateway-host}}/di/v1/results/&quot; + body + &quot;.&quot; + sig;
            }
          }</value>
        </set-header>
      </when>
    </choose>
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
